# Example environment variables for local development.
# Copy to `.env` and fill real values (DO NOT commit `.env`).

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB (use your Atlas connection string in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mydb?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Backblaze B2
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=your_b2_bucket_name
B2_BUCKET_ID=your_b2_bucket_id
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_SIGNED_URL_EXPIRY_SECONDS=3600

# Resend email
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=beejvedanaturals@beejvedanaturals.com
ADMIN_EMAIL=beejvedanaturals@beejvedanaturals.com
APP_NAME=BeejVedaNaturals
